# Copy this file to .env (which is git-ignored) and fill in real values,
# or export the variables directly in your shell / process manager.
#
# The application reads these ONLY from the environment - never from files
# committed to source control, and never logs their values.

# Base URL of an OpenAI-compatible Chat Completions API.
# Example for a locally hosted Luna-compatible gateway:
OPENAI_BASE_URL=https://api.example-openai-compatible-endpoint.invalid/v1

# API key for the endpoint above. Keep this secret; never commit it.
OPENAI_API_KEY=replace-with-your-api-key

# Chat completion model name. Defaults to gpt-5.6-luna if unset.
OPENAI_MODEL=gpt-5.6-luna
